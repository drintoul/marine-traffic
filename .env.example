# Hostname of the Redis container on the compose network (used by all services)
REDIS_HOST=redis

# Host port that exposes Redis (container port is always 6379)
REDIS_PORT=6379

# Host port for the ml-engine dashboard/API (container port is always 8000)
ML_ENGINE_PORT=8090

# Ollama endpoint used by agent-worker for LLM advisories.
# host.docker.internal resolves to the Docker host (extra_hosts mapping in compose).
OLLAMA_HOST=http://host.docker.internal:11434

# API key for aisstream.io live AIS feed (used by ais-ingest service).
# Register free at https://aisstream.io then paste the key here.
AISSTREAM_API_KEY=your_aisstream_api_key
